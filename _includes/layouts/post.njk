---
layout: "layouts/base.njk"
---
<article>
    <h1>{{ title }}</h1>
    <p>
      <time datetime="{{ page.date | readableDate('yyyy-LL-dd') }}">    
        {% if start_date and end_date %}
            {% dateRange start_date, end_date %}
        {% else %}
            {{ page.date | readableDate('dd LLL yyyy') }}
        {% endif %}
      </time>
    </p>
    
    {% if tags %}
    <p class="tag-list">
        Tags:
        {% for tag in tags %}
          {% if tag != "posts" %} {# A little trick to exclude Eleventy's automatic 'posts' tag #}
            <a href="{{ ('/tags/' + tag + '.html') | url }}" class="tag-badge">#{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </p>
    {% endif %}
    <hr>

  {# The main content of your Markdown file will be injected here #}
  {{ content | safe }}
  
<hr>
<!-- Giscus Widget -->
<div id="giscus">
<script src="https://giscus.app/client.js"
        data-repo="choongzhanhong/choongzhanhong.github.io"
        data-repo-id="MDEwOlJlcG9zaXRvcnkzNzE1Njc5MDM="
        data-category="General"
        data-category-id="DIC_kwDOFiWtH84DBuAJ"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="0"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="light"
        data-lang="en"
        data-loading="lazy"
        crossorigin="anonymous"
        async>
</script>
</div>
</article>

<aside>
    <a href="#"><b>Top</b></a>
	{{ content | toc | safe }}
</aside>
  
<p>
    <a href="/blog.html"><== Back to Blog</a>
</p>